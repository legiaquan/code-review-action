{
  "name": "ai-code-review-action",
  "version": "1.0.1",
  "description": "AI-powered code review GitHub Action with pluggable providers",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "package": "npm run build && ncc build dist/index.js -o dist --source-map --license licenses.txt",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:local": "node scripts/test-local.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "ci": "npm run lint && npm test && npm run build && npm run package",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legiaquan/code-review-action.git"
  },
  "keywords": [
    "github-action",
    "code-review",
    "ai",
    "typescript",
    "gemini",
    "openai"
  ],
  "author": "Quan Le",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@google/generative-ai": "^0.15.0",
    "@octokit/rest": "^20.0.2",
    "minimatch": "^9.0.3",
    "openai": "^4.20.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
